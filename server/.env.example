# ---------------------------------------------------------------------------
# Unique Properties — environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Primary connection (use a pooled connection string in production, e.g. PgBouncer
# or Prisma Accelerate). For migrations, Prisma needs a DIRECT connection too.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unique_properties?schema=public"

# Direct (non-pooled) URL used by `prisma migrate`. Same host when developing locally.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/unique_properties?schema=public"

# App
NODE_ENV="development"
PORT="4000"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Media storage (LOCAL | S3 | CLOUDINARY | GCS | AZURE)
STORAGE_PROVIDER="LOCAL"
# S3_BUCKET=""
# S3_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
